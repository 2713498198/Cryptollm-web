MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
MYSQL_DATABASE=cryptollm
DB_USERNAME=cryptollm
DB_PASSWORD=replace_with_database_password
REDIS_PASSWORD=replace_with_redis_password

DB_URL=jdbc:mysql://mysql:3306/cryptollm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

SMS_CODE_EXPIRE_SECONDS=300
SMS_RESEND_INTERVAL_SECONDS=60
TOKEN_EXPIRE_SECONDS=604800
CORS_ALLOWED_ORIGIN=https://cryptollm.net

ALIYUN_SMS_ACCESS_KEY_ID=replace_with_aliyun_access_key_id
ALIYUN_SMS_ACCESS_KEY_SECRET=replace_with_aliyun_access_key_secret
ALIYUN_SMS_SIGN_NAME=replace_with_sms_sign_name
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=replace_with_login_template_code
ALIYUN_SMS_CHANGE_PASSWORD_TEMPLATE_CODE=replace_with_change_password_template_code
